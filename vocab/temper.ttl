# temper vocabulary: terms for document-metadata keys that have no exact
# Dublin Core or PROV-O equivalent.
#
# Namespace: https://w3id.org/temper#
#
# Why not prov: directly? prov:used and prov:wasGeneratedBy describe an
# activity, and prov:wasAttributedTo expects an agent node. temper's
# frontmatter is flat: these keys sit on the document and hold strings. Mapped
# to prov: terms, an RDFS reasoner would infer that each document is a
# prov:Activity. These terms carry the same meaning without domain or range
# constraints, and rdfs:seeAlso names the PROV-O term each one approximates.
#
# Every temper: term used in examples/context.jsonld must be defined here,
# and every term defined here must be used there (test/temper/okf/vocab_test.clj).

@prefix temper: <https://w3id.org/temper#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

<https://w3id.org/temper>
    a owl:Ontology ;
    rdfs:label "temper vocabulary" ;
    dcterms:description "Terms for OKF document frontmatter that Dublin Core Terms and PROV-O do not cover exactly." ;
    rdfs:seeAlso <https://github.com/lambduhh/temper> .

temper:aiAssisted
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "AI assisted" ;
    rdfs:comment "Free-text name of the AI model and interface that drafted the document, e.g. \"Claude Opus 5 via Claude Code\". Frontmatter key: ai_assisted." ;
    rdfs:seeAlso prov:wasAttributedTo, prov:SoftwareAgent .

temper:session
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "session" ;
    rdfs:comment "Identifier of the AI session that generated the document. A correlation key, not a resolvable activity. Frontmatter key: session." ;
    rdfs:seeAlso prov:wasGeneratedBy .

temper:tool
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "tool" ;
    rdfs:comment "A tool or data source available to the session that generated the document. Frontmatter key: tools (one value per list item)." ;
    rdfs:seeAlso prov:used .

temper:agentSkill
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "agent skill" ;
    rdfs:comment "An agent or skill definition applied while generating the document, ideally a commit-pinned URL. Frontmatter key: agents_skills (one value per list item)." ;
    rdfs:seeAlso prov:used .

temper:reviewMaturity
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "review maturity" ;
    rdfs:comment "How far a human has gone in reviewing the document, written as a level code and its label, e.g. \"L2 (Human-reviewed)\". The levels are defined by the :review-maturity ladder in each bundle's metadata schema, not here, so a bundle can define its own. It describes review trust, not a publication lifecycle stage. Frontmatter key: review_maturity." ;
    rdfs:seeAlso <http://schema.org/creativeWorkStatus>, dcterms:dateAccepted .

# --- OKF v0.2 families (generated, verified, sources, usage_window, stale_after)

temper:actor
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "actor" ;
    rdfs:comment "An OKF v0.2 actor string (§7): <producer>/<version> for agents and tools, human:<id> for a person, process:<id> for an automated process. Frontmatter key: generated.by, verified.by." ;
    rdfs:seeAlso prov:wasAssociatedWith, prov:Agent .

temper:verification
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "verification" ;
    rdfs:comment "A verification event: who or what confirmed the document against its sources, and when (OKF v0.2 §5.2). Frontmatter key: verified." ;
    rdfs:seeAlso dcterms:dateAccepted .

temper:sourceKey
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "source key" ;
    rdfs:comment "The stable id of a sources entry, used as a footnote label to attribute claims (OKF v0.2 §5.1). Frontmatter key: sources[].id." .

temper:usageCount
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "usage count" ;
    rdfs:comment "How often a source was exercised over the usage window; a liveness signal, not a score (OKF v0.2 §5.1). Frontmatter key: sources[].usage_count." .

temper:usageWindow
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "usage window" ;
    rdfs:comment "The time range every usage_count is measured over (OKF v0.2 §5.1). Frontmatter key: usage_window." .

temper:windowStart
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "window start" ;
    rdfs:comment "Start of a usage window. Frontmatter key: usage_window.from." .

temper:windowEnd
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "window end" ;
    rdfs:comment "End of a usage window. Frontmatter key: usage_window.to." .

temper:staleAfter
    a rdf:Property ;
    rdfs:isDefinedBy <https://w3id.org/temper> ;
    rdfs:label "stale after" ;
    rdfs:comment "The instant on or after which the document's content is stale (OKF v0.2 §5.5). Frontmatter key: stale_after." ;
    rdfs:seeAlso dcterms:valid .
